DATABASE_URL=            # Neon Postgres URL. Leave empty in dev to use embedded PGlite.
SOURCER_PASSCODE=demo
JWT_SECRET=              # 32+ random chars (required in production)
NEXT_PUBLIC_APP_URL=https://usman-devs.online
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (photo uploads in production)
RESEND_API_KEY=          # optional; interest notifications are logged if empty
EMAIL_FROM=              # optional, e.g. "Deal Room <deals@yourdomain.com>"
DEMO_ORG_ID=             # optional; defaults to the first org
